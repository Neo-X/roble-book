@ARTICLE{Jaegle2021-fx,
  title         = "Perceiver {IO}: A General Architecture for Structured Inputs
                   \& Outputs",
  author        = "Jaegle, Andrew and Borgeaud, Sebastian and Alayrac,
                   Jean-Baptiste and Doersch, Carl and Ionescu, Catalin and
                   Ding, David and Koppula, Skanda and Zoran, Daniel and Brock,
