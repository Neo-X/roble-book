@ARTICLE{Klyubin2005-dc,
  title    = "Empowerment: A universal agent-centric measure of control",
  author   = "Klyubin, Alexander S and Polani, Daniel and Nehaniv, Chrystopher
              L",
  abstract = "The classical approach to using utility functions suffers from
              the drawback of having to design and tweak the functions on a
              case by case basis. Inspired by examples from the animal kingdom,
              social sciences and games we propose empowerment, a rather
              universal function, defined as the information-theoretic capacity
              of an agent's actuation channel. The concept applies to any
              sensorimotor apparatus. Empowerment as a measure reflects the
              properties of the apparatus as long as they are observable due to
              the coupling of sensors and actuators via the environment. Using
              two simple experiments we also demonstrate how empowerment
              influences sensor-actuator evolution. \copyright{} 2005 IEEE.",
