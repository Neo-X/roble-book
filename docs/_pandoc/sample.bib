@UNPUBLISHED{Farebrother2023-cv,
  title    = "Proto-value networks: Scaling representation learning with
              auxiliary tasks",
  author   = "Farebrother, Jesse and Greaves, Joshua and Agarwal, Rishabh and
              Le Lan, Charline and Goroshin, Ross and Castro, Pablo Samuel and
              Bellemare, Marc G",
  abstract = "Auxiliary tasks improve the representations learned by deep
              reinforcement learning agents. Analytically, their effect is
