  journal   = "Int Conf Learn Represent",
  publisher = "openreview.net",
  volume    = "abs/2310.17722",
  abstract  = "We show that large language models (LLMs) can be adapted to be
               generalizable policies for embodied visual tasks. Our approach,
               called Large LAnguage model Reinforcement Learning Policy
               (LLaRP), adapts a pre-trained frozen LLM to take as input text
