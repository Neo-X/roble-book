@ARTICLE{Hansen2023-pc,
  title     = "{TD}-{MPC2}: Scalable, robust world models for continuous control",
  author    = "Hansen, Nicklas and Su, Hao and Wang, Xiaolong",
  journal   = "Int Conf Learn Represent",
  publisher = "openreview.net",
  volume    = "abs/2310.16828",
  abstract  = "TD-MPC is a model-based reinforcement learning (RL) algorithm
