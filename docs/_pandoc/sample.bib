  month         =  dec,
  year          =  2024,
  archivePrefix = "arXiv",
  primaryClass  = "cs.AI"
}

@ARTICLE{Mazzaglia2024-df,
  title     = "{GenRL}: Multimodal-foundation world models for generalization in
