@ARTICLE{Hansen2022-za,
  title     = "Temporal difference learning for model predictive control",
  author    = "Hansen, Nicklas and Wang, Xiaolong and Su, H",
  editor    = "Chaudhuri, Kamalika and Jegelka, Stefanie and Song, Le and
               Szepesvari, Csaba and Niu, Gang and Sabato, Sivan",
  journal   = "ICML",
  publisher = "PMLR",
  volume    =  162,
  pages     = "8387--8406",
  abstract  = "Data-driven model predictive control has two key advantages over
               model-free methods: a potential for improved sample efficiency
               through model learning, and better performance as computational
               budget for planning increases. However, it is both costly to plan
               over long horizons and challenging to obtain an accurate model of
               the environment. In this work, we combine the strengths of
